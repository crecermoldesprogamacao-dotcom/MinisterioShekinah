@model IEnumerable<EnsaioItemViewModel>
@{
    ViewData["Title"] = "Cronograma de Ensaio Inteligente";
}

<div class="container my-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-warning fw-bold mb-1">🎸 Cronograma de Ensaio Inteligente</h1>
            <p class="text-light opacity-75 m-0">Análise de dificuldade, tessitura vocal e ritmo gerada por IA para @ViewBag.NomeEvento.</p>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-light btn-sm fw-bold">Voltar</a>
    </div>

    <div class="alert bg-black border-warning text-light mb-4 rounded-4 p-4">
        <h5 class="text-warning fw-bold mb-2"><i class="bi bi-lightbulb-fill me-2"></i> Dica do Diretor Musical IA:</h5>
        <p class="mb-0 small text-light opacity-75">
            As músicas classificadas como <strong>Avançado</strong> ou com muitas pestanas devem ser passadas primeiro no ensaio. Verifique também se as tonalidades estão confortáveis para o coro da semana.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        int contador = 1;
        foreach (var item in Model)
        {
            bool ehAvancado = item.Dificuldade.Contains("Avançado", StringComparison.OrdinalIgnoreCase);
            bool ehIntermediario = item.Dificuldade.Contains("Intermediário", StringComparison.OrdinalIgnoreCase);
            
            <div class="card bg-dark border-secondary shadow-lg rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-black border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-secondary mb-1">@(string.IsNullOrEmpty(item.Musica?.MomentoLiturgico) ? "Geral" : item.Musica.MomentoLiturgico)</span>
                        <h4 class="text-warning fw-bold mb-0">@(contador++). @(item.Musica?.Titulo ?? item.Id.ToString())</h4>
                    </div>
                    <div class="text-end">
                        <span class="badge @(ehAvancado ? "bg-danger" : ehIntermediario ? "bg-warning text-dark" : "bg-success") fw-bold px-3 py-2">
                            @item.Dificuldade
                        </span>
                    </div>
                </div>
                <div class="card-body p-4 text-light">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 rounded bg-black border border-secondary h-100">
                                <span class="text-warning small fw-bold d-block mb-1">🎵 Tom e Capotraste:</span>
                                <span class="fw-bold">Tom: @(item.Musica?.TomOriginal ?? "C")</span>
                                <div class="small text-muted mt-1">@item.SugestaoCapo</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded bg-black border border-secondary h-100">
                                <span class="text-warning small fw-bold d-block mb-1">🎤 Tessitura Vocal:</span>
                                <span class="small">@item.Tessitura</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 rounded bg-black border border-secondary h-100">
                                <span class="text-warning small fw-bold d-block mb-1">🥁 Ritmo / Andamento:</span>
                                <span class="small">@item.RitmoBpm</span>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <a asp-controller="Musicas" asp-action="Teleprompter" asp-route-id="@(item.Musica?.Id ?? item.Id)" class="btn btn-sm btn-outline-warning fw-bold">
                            <i class="bi bi-display me-1"></i> Abrir Cifra / Teleprompter
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <p class="text-muted">Nenhuma música selecionada para análise.</p>
        </div>
    }
</div>

<style>
    body {
        background-color: #0b0b0d;
        color: #f8f9fa;
    }
</style>