@model IEnumerable<MinisterioShekinah.Web.Models.Musica>
@{
    Layout = null;
    string nomeEvento = ViewBag.NomeEvento ?? "Santa Missa";
    string corLiturgica = ViewBag.CorLiturgica ?? "";
    string salmoRefrao = ViewBag.SalmoRefrao ?? "";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <title>@nomeEvento - Ministério Shekinah</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #ffffff;
            color: #000000;
            font-family: 'Georgia', serif;
            padding: 30px;
        }

        .cabecalho-missal {
            border-bottom: 2px solid #b8860b;
            padding-bottom: 15px;
            margin-bottom: 20px;
            text-align: center;
        }

        .salmo-box {
            background-color: #fdfbf7;
            border: 1px solid #d4af37;
            border-left: 5px solid #b8860b;
            padding: 10px 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .momento-titulo {
            background-color: #f4f1ea;
            border-left: 4px solid #b8860b;
            padding: 5px 12px;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 0.85rem;
            margin-top: 18px;
        }

        .cifra-bloco {
            font-family: 'Courier New', Courier, monospace;
            white-space: pre-wrap;
            font-size: 0.95rem;
            line-height: 1.4;
            margin-top: 8px;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="d-flex justify-content-between mb-4 no-print">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">← Voltar</a>
            <button onclick="window.print()" class="btn btn-warning fw-bold">🖨️ Imprimir / Salvar como PDF</button>
        </div>

        <div class="cabecalho-missal">
            <small class="text-uppercase tracking-wider text-muted fw-bold">Ministério de Música Shekinah</small>
            <h2 class="fw-bold mb-1 mt-1">@nomeEvento</h2>
            @if (!string.IsNullOrEmpty(corLiturgica))
            {
                <span class="badge bg-dark">Cor Litúrgica: @corLiturgica</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(salmoRefrao))
        {
            <div class="salmo-box">
                <strong class="text-uppercase small d-block mb-1" style="color: #8a6508;">Refrão do Salmo Responsorial:</strong>
                <span class="fst-italic fw-bold">@salmoRefrao</span>
            </div>
        }

        @if (!Model.Any())
        {
            <p class="text-center text-muted">Nenhuma música selecionada para este missal.</p>
        }
        else
        {
            foreach (var musica in Model)
            {
                <div class="mb-4" style="page-break-inside: avoid;">
                    <div class="momento-titulo">
                        @(string.IsNullOrEmpty(musica.MomentoLiturgico) ? "Canto Litúrgico" : musica.MomentoLiturgico)
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline mt-2">
                        <h4 class="fw-bold mb-0">@musica.Titulo</h4>
                        <span class="badge bg-dark">Tom: @musica.TomOriginal @(musica.Capotraste > 0 ? $"| Capo {musica.Capotraste}ª" : "")</span>
                    </div>
                    <pre class="cifra-bloco">@musica.Cifra</pre>
                </div>
            }
        }
    </div>

    <script>
        window.onload = function() {
            window.print();
        };
    </script>
</body>
</html>