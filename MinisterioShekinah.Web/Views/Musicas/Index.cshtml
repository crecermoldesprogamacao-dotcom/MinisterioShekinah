@model IEnumerable<MinisterioShekinah.Web.Models.Musica>

@{
    ViewData["Title"] = "Repertório & Cifras";
}

<div class="container mt-4 mb-5">
    <!-- Cabeçalho da Página -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="text-warning fw-bold mb-1"><i class="bi bi-music-note-beamed"></i> Repertório & Cifras</h1>
            <p class="text-light opacity-75 m-0">Gerencie as canções, tons, cifras e partituras do Ministério Shekinah.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-warning text-dark fw-bold px-4 shadow">
                <i class="bi bi-plus-lg"></i> Nova Música
            </a>
        </div>
    </div>

    <!-- Barra de Pesquisa Rápida -->
    <div class="card bg-dark border-warning mb-4 shadow-sm">
        <div class="card-body py-3">
            <div class="input-group">
                <span class="input-group-text bg-black border-warning text-warning"><i class="bi bi-search"></i></span>
                <input type="text" id="filtroMusicas" class="form-control bg-black text-light border-warning" placeholder="Digite o nome da música ou artista para filtrar..." onkeyup="filtrarMusicas()">
            </div>
        </div>
    </div>

    <!-- Tabela / Lista de Músicas -->
    <div class="card bg-dark border-secondary shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" id="tabelaMusicas">
                    <thead class="table-black text-warning border-bottom border-secondary">
                        <tr>
                            <th class="py-3 px-4">Título</th>
                            <th class="py-3">Artista</th>
                            <th class="py-3 text-center">Tom Original</th>
                            <th class="py-3 text-center">Capotraste</th>
                            <th class="py-3 text-center">Partitura</th>
                            <th class="py-3 text-end px-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-bold text-light">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-warning text-decoration-none">
                                            @item.Titulo
                                        </a>
                                    </td>
                                    <td class="text-light opacity-75">@(string.IsNullOrEmpty(item.Artista) ? "Ministério Shekinah" : item.Artista)</td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark fw-bold px-2 py-1">@item.TomOriginal</span>
                                    </td>
                                    <td class="text-center text-light">
                                        @(item.Capotraste > 0 ? $"{item.Capotraste}ª Casa" : "Nenhum")
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.PartituraUrl))
                                        {
                                            <a href="@item.PartituraUrl" target="_blank" class="text-warning fs-5" title="Ver Partitura">
                                                <i class="bi bi-file-earmark-music-fill"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Ver Cifra">
                                                <i class="bi bi-eye"></i> Cifra
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-music-note fs-2 d-block mb-2"></i>
                                    Nenhuma música cadastrada no repertório ainda. Clique em "Nova Música" para começar.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-black {
        background-color: #121212;
    }

    .table-dark {
        --bs-table-bg: #1a1a1a;
        --bs-table-hover-bg: #222222;
        color: #e0e0e0;
    }

    .text-gold {
        color: #dfb235;
    }
</style>

<script>
    // Script simples para filtragem instantânea na tabela
    function filtrarMusicas() {
        let input = document.getElementById("filtroMusicas");
        let filtro = input.value.toLowerCase();
        let tabela = document.getElementById("tabelaMusicas");
        let linhas = tabela.getElementsByTagName("tr");

        for (let i = 1; i < linhas.length; i++) {
            let linha = linhas[i];
            let textoLinha = linha.textContent || linha.innerText;
            if (textoLinha.toLowerCase().indexOf(filtro) > -1) {
                linha.style.display = "";
            } else {
                linha.style.display = "none";
            }
        }
    }
</script>