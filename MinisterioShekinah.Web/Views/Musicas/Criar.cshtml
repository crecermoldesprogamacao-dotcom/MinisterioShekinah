@model MinisterioShekinah.Web.Models.Musica
@{
    ViewData["Title"] = "Adicionar Nova Música";
}
<div class="container my-5" style="max-width: 800px;">
    <div class="card bg-dark border-warning shadow-lg p-4 rounded-4">
        <div class="card-body">
            <h2 class="text-warning fw-bold mb-3 text-center"><i class="bi bi-plus-circle"></i> Adicionar Nova Música</h2>
            <p class="text-light text-center opacity-75 mb-4">Insira os dados da canção e a respetiva cifra para o repertório da paróquia.</p>
            <form asp-action="Criar">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label text-warning fw-bold">Título da Música</label>
                    <input asp-for="Titulo" class="form-control bg-black text-light border-secondary" placeholder="Ex: Cordeiro de Deus" required />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Artista" class="form-label text-warning fw-bold">Artista / Ministério</label>
                        <input asp-for="Artista" class="form-control bg-black text-light border-secondary" placeholder="Ex: Ministério Shekinah" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="TomOriginal" class="form-label text-warning fw-bold">Tom Original</label>
                        <input asp-for="TomOriginal" class="form-control bg-black text-light border-secondary" placeholder="Ex: Bm" required />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Capotraste" class="form-label text-warning fw-bold">Capotraste</label>
                        <input asp-for="Capotraste" type="number" min="0" max="12" class="form-control bg-black text-light border-secondary" value="0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="MomentoLiturgico" class="form-label text-warning fw-bold">Momento Litúrgico / Canto</label>
                    <select asp-for="MomentoLiturgico" class="form-select bg-black text-light border-secondary">
                        <option value="">Selecione o momento da Missa (Opcional)...</option>
                        <option value="Entrada">Entrada</option>
                        <option value="Ato Penitencial">Ato Penitencial</option>
                        <option value="Hino de Louvor (Glória)">Hino de Louvor (Glória)</option>
                        <option value="Salmo Responsorial">Salmo Responsorial</option>
                        <option value="Aclamação ao Evangelho">Aclamação ao Evangelho (Aleluia)</option>
                        <option value="Ofertório">Ofertório</option>
                        <option value="Santo">Santo</option>
                        <option value="Amém (Doxologia)">Amém (Doxologia)</option>
                        <option value="Cordeiro de Deus">Cordeiro de Deus</option>
                        <option value="Comunhão">Comunhão</option>
                        <option value="Pós-Comunhão">Pós-Comunhão / Ação de Graças</option>
                        <option value="Final / Envio">Final / Envio</option>
                        <option value="Adoração / Louvor Geral">Adoração / Louvor Geral</option>
                    </select>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label asp-for="Cifra" class="form-label text-warning fw-bold mb-0">Cifra com Acordes entre Colchetes</label>
                        <button type="button" id="btnOrganizarIa" class="btn btn-sm btn-outline-warning fw-bold">
                            ✨ Organizar com IA
                        </button>
                    </div>
                    <div id="statusIa" class="small mb-2" style="display: none;"></div>
                    <textarea asp-for="Cifra" rows="10" class="form-control bg-black text-light border-secondary font-monospace" placeholder="Ex: [G]       [D/F#]&#10;Vem com Tua glória..." required></textarea>
                    <small class="text-muted">Dica: Coloque os acordes entre parênteses rectos (ex: `[G]`, `[D/F#]`) para que o sistema permita transpor o tom automaticamente.</small>
                </div>
                <div class="mb-4">
                    <label asp-for="PartituraUrl" class="form-label text-warning fw-bold">Link da Partitura (Opcional)</label>
                    <input asp-for="PartituraUrl" class="form-control bg-black text-light border-secondary" placeholder="URL para PDF ou partitura" />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Repertorio" class="btn btn-outline-light">Voltar ao Repertório</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Salvar Música</button>
                </div>
            </form>
        </div>
    </div>
</div>
<style>
    body {
        background-color: #121212;
        color: #f8f9fa;
    }

    .form-control:focus, .form-select:focus {
        background-color: #000;
        color: #fff;
        border-color: #dfb235;
        box-shadow: 0 0 0 0.25rem rgba(223, 178, 53, 0.25);
    }
</style>
@section Scripts {
    <script>
        document.getElementById('btnOrganizarIa').addEventListener('click', async function() {
            const btn = this;
            const statusDiv = document.getElementById('statusIa');
            const tituloInput = document.getElementById('Titulo');
            const cifraInput = document.getElementById('Cifra');
            const tomInput = document.getElementById('TomOriginal');
            const momentoSelect = document.getElementById('MomentoLiturgico');
            if (!cifraInput.value.trim()) {
                statusDiv.style.display = 'block';
                statusDiv.className = 'small mb-2 text-danger';
                statusDiv.textContent = 'Cole a letra ou cifra antes de clicar em Organizar com IA.';
                return;
            }
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> A organizar...';
            statusDiv.style.display = 'none';
            try {
                const response = await fetch('@Url.Action("OrganizarComIa", "Musicas")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        titulo: tituloInput.value,
                        cifra: cifraInput.value
                    })
                });
                const textoResposta = await response.text();
                let data;
                try {
                    data = JSON.parse(textoResposta);
                } catch {
                    throw new Error('Resposta inválida do servidor.');
                }
                if (!response.ok) {
                    throw new Error(data.erro || 'Erro ao processar a cifra.');
                }
                if (data.cifraFormatada) cifraInput.value = data.cifraFormatada;
                if (data.tomDetectado) tomInput.value = data.tomDetectado;
                if (data.momentoSugerido && data.momentoSugerido !== 'Outro') {
                    const mapaMomentos = {
                        'Glória': 'Hino de Louvor (Glória)',
                        'Salmo': 'Salmo Responsorial',
                        'Ação de Graças': 'Pós-Comunhão',
                        'Final': 'Final / Envio',
                        'Adoração': 'Adoração / Louvor Geral'
                    };
                    const valorAlvo = mapaMomentos[data.momentoSugerido] || data.momentoSugerido;
                    for (let i = 0; i < momentoSelect.options.length; i++) {
                        if (momentoSelect.options[i].value === valorAlvo) {
                            momentoSelect.selectedIndex = i;
                            break;
                        }
                    }
                }
                statusDiv.style.display = 'block';
                statusDiv.className = 'small mb-2 text-success';
                statusDiv.textContent = `✨ Cifra organizada! Tom detetado: ${data.tomDetectado} | Momento: ${data.momentoSugerido} | ${data.sugestaoCapotraste}`;
            } catch (error) {
                statusDiv.style.display = 'block';
                statusDiv.className = 'small mb-2 text-danger';
                statusDiv.textContent = 'Erro: ' + error.message;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '✨ Organizar com IA';
            }
        });
    </script>
}
