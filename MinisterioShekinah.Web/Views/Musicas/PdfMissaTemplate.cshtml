@model dynamic
@{
    Layout = null;
    var nomeEvento = Model.NomeEvento;
    var musicas = Model.Musicas;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@nomeEvento - Ministério Shekinah</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: Arial, sans-serif !important;
            font-size: 14pt !important;
            background-color: #ffffff;
            color: #000000;
            margin: 40px;
        }

        .pagina-musica {
            page-break-after: always;
            min-height: 90vh;
            padding-bottom: 40px;
            border-bottom: 2px dashed #ddd;
            margin-bottom: 40px;
        }

        .cabecalho-missa {
            text-align: center;
            margin-bottom: 40px;
            font-family: Arial, sans-serif;
        }

            .cabecalho-missa h2 {
                font-size: 14pt;
                color: #555;
                text-transform: uppercase;
                letter-spacing: 2px;
            }

            .cabecalho-missa h1 {
                font-size: 20pt;
                font-weight: bold;
                color: #111;
                margin-top: 5px;
            }

        .badge-momento {
            background-color: #f0f0f0;
            color: #333;
            border: 1px solid #ccc;
            padding: 4px 12px;
            font-size: 11pt;
            font-weight: bold;
            border-radius: 6px;
            display: inline-block;
            margin-bottom: 10px;
        }

        .titulo-musica {
            font-size: 18pt;
            font-weight: bold;
            color: #222;
            margin-bottom: 5px;
        }

        .info-tom {
            font-size: 12pt;
            font-weight: bold;
            color: #444;
            margin-bottom: 20px;
        }

        .cifra-container {
            font-family: Arial, sans-serif !important;
            font-size: 14pt !important;
            line-height: 1.6 !important;
            white-space: pre-wrap !important;
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #e5e5e5;
            color: #111;
        }

            .cifra-container .acorde-negrito {
                font-weight: bold !important;
                color: #996515 !important;
            }

        @@media print {
            .nao-imprimir {
                display: none;
            }

            body {
                margin: 15px;
            }

            .cifra-container {
                background-color: transparent;
                border: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="nao-imprimir d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded shadow-sm">
        <span class="fw-bold text-secondary">Visualização Pronta para Impressão / Tablet</span>
        <button onclick="window.print()" class="btn btn-dark fw-bold px-4">
            <i class="bi bi-printer-fill me-2"></i> Imprimir / Guardar PDF
        </button>
    </div>
    <div class="cabecalho-missa">
        <h2>Ministério de Música Shekinah</h2>
        <h1>@nomeEvento</h1>
        <p class="text-muted" style="font-size: 12pt;">Repertório para Celebração Litúrgica</p>
    </div>
    @foreach (var m in musicas)
    {
        <div class="pagina-musica">
            <div>
                <span class="badge-momento">@(string.IsNullOrEmpty(m.MomentoLiturgico) ? "Música" : m.MomentoLiturgico)</span>
                <div class="titulo-musica">@m.Titulo</div>
                <div class="info-tom">
                    Tom Original: @m.TomOriginal
                    @(m.Capotraste > 0 ? $"| Capotraste: {m.Capotraste}ª Casa" : "")
                    @(string.IsNullOrEmpty(m.Artista) ? "" : $"| Artista: {m.Artista}")
                </div>
            </div>
            <div class="cifra-container" id="cifra-@m.Id">@m.Cifra</div>
        </div>
    }
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll(".cifra-container").forEach(el => {
                let texto = el.innerText;
                let linhas = texto.split('\n');
                let linhasProcessadas = linhas.map(linha => {
                    return linha.split(/(\s+)/).map(token => {
                        let t = token.trim();
                        if (t.length > 0 && t.length <= 8 && /^(?:\[)?[A-G][b#]?(?:m|maj|min|dim|aug|sus|add|\+|\-|°|0|[0-9#bM])*(?:\/[A-G][b#]?)?(?:\])?$/.test(t)) {
                            let limpo = t.replace(/[\[\]]/g, '');
                            return `<b class="acorde-negrito">${limpo}</b>`;
                        }
                        return token;
                    }).join('');
                });
                el.innerHTML = linhasProcessadas.join('\n');
            });
        });
    </script>
</body>
</html>