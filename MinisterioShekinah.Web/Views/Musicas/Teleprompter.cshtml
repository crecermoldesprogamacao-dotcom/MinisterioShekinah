@model IEnumerable<MinisterioShekinah.Web.Models.Musica>
@{
    var listaMusicas = Model?.ToList() ?? new List<MinisterioShekinah.Web.Models.Musica>();
    var primeiraMusica = listaMusicas.FirstOrDefault();
    string nomeEvento = ViewBag.NomeEvento ?? (primeiraMusica?.Titulo ?? "Teleprompter");
    string corLiturgica = ViewBag.CorLiturgica ?? "";
    string salmoRefrao = ViewBag.SalmoRefrao ?? "";
    ViewData["Title"] = "Teleprompter - " + nomeEvento;
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #0b0b0d;
            color: #f8f9fa;
            font-family: 'Courier New', Courier, monospace;
            overflow-x: hidden;
            padding-top: 95px;
            padding-bottom: 55vh;
        }

        .toolbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background-color: #16161a;
            border-bottom: 2px solid #dfb235;
            padding: 10px 18px;
            z-index: 1000;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
            transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
        }

        .controls-hidden {
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }

        #cifra-container {
            max-width: 920px;
            margin: 0 auto;
            padding: 25px 20px;
            font-size: 18px;
            line-height: 1.5;
        }

        .conteudo-cifra-item {
            font-family: 'Courier New', Courier, monospace;
            width: 100%;
            padding-bottom: 15px;
        }

        .linha-cifra-par {
            display: flex;
            flex-direction: column;
            margin-bottom: 6px;
            border-radius: 6px;
            padding: 2px 6px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .linha-acordes {
            color: #dfb235;
            font-weight: bold;
            white-space: pre-wrap;
            word-break: break-word;
            line-height: 1.25;
        }

        .linha-texto {
            color: #f8f9fa;
            white-space: pre-wrap;
            word-break: break-word;
            line-height: 1.35;
        }

        .linha-vazia {
            height: 14px;
        }

        .musica-bloco {
            margin-bottom: 70px;
            padding-bottom: 40px;
            border-bottom: 2px dashed #333;
            scroll-margin-top: 105px;
        }

            .musica-bloco:last-child {
                border-bottom: none;
            }

        .acorde {
            color: #dfb235;
            font-weight: bold;
            font-family: 'Courier New', Courier, monospace;
        }

        .linha-ativa-voz {
            background-color: rgba(223, 178, 53, 0.18);
            color: #ffffff;
            text-shadow: 0 0 8px rgba(223, 178, 53, 0.5);
            border-left: 4px solid #dfb235;
        }

        .liturgia-badge {
            background-color: #6f42c1;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-family: sans-serif;
            font-size: 0.85rem;
            font-weight: bold;
        }

        .btn-gold {
            background-color: #dfb235;
            border-color: #dfb235;
            color: #121212;
            font-weight: bold;
        }

            .btn-gold:hover {
                background-color: #c4992b;
                border-color: #c4992b;
                color: #121212;
            }

        @@media (max-width: 576px) {
            body {
                padding-top: 135px;
            }

            #cifra-container {
                padding: 15px 12px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <div class="d-flex align-items-center gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-light btn-sm fw-bold">
                <i class="bi bi-arrow-left"></i> Voltar
            </a>
            @if (listaMusicas.Count > 1)
            {
                <select id="atalho-momento" class="form-select form-select-sm bg-dark text-warning border-warning fw-bold" style="max-width: 230px; font-family: sans-serif;" onchange="irParaMusica(this.value)">
                    <option value="">⚡ Ir para o canto...</option>
                    @for (int idx = 0; idx < listaMusicas.Count; idx++)
                    {
                        var m = listaMusicas[idx];
                        string label = string.IsNullOrEmpty(m.MomentoLiturgico) ? m.Titulo : $"{m.MomentoLiturgico}: {m.Titulo}";
                        <option value="musica-sec-@idx">@(idx + 1). @label</option>
                    }
                </select>
            }
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="text-light small d-none d-md-inline" style="font-family: sans-serif;">Tom:</span>
            @if (listaMusicas.Count == 1 && primeiraMusica != null)
            {
                <span id="tom-display" class="badge bg-warning text-dark fs-6 fw-bold" style="font-family: sans-serif;">@(primeiraMusica.TomOriginal?.ToUpper() ?? "C")</span>
            }
            else
            {
                <span id="tom-display" class="badge bg-warning text-dark fs-6 fw-bold" style="font-family: sans-serif;">Original</span>
            }
            <button class="btn btn-gold btn-sm" onclick="alterarTom(-1)" title="Diminuir meio tom">- ½</button>
            <button class="btn btn-gold btn-sm" onclick="alterarTom(1)" title="Aumentar meio tom">+ ½</button>
            <div class="d-flex align-items-center gap-1 ms-2" style="font-family: sans-serif;">
                <label for="capo-select" class="text-warning small fw-bold mb-0">Capo:</label>
                <select id="capo-select" class="form-select form-select-sm bg-dark text-warning border-warning fw-bold" style="width: auto;" onchange="alterarCapo()">
                    <option value="0">Sem Capo</option>
                    @for (int i = 1; i <= 12; i++)
                    {
                        if (listaMusicas.Count == 1 && primeiraMusica?.Capotraste == i)
                        {
                            <option value="@i" selected>@(i)ª casa</option>
                        }
                        else
                        {
                            <option value="@i">@(i)ª casa</option>
                        }
                    }
                </select>
            </div>
            <div class="btn-group btn-group-sm ms-2">
                <button class="btn btn-outline-warning text-light fw-bold" onclick="mudarFonte(-2)">A-</button>
                <button class="btn btn-outline-warning text-light fw-bold" onclick="mudarFonte(2)">A+</button>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button id="btn-voz" class="btn btn-outline-warning btn-sm fw-bold px-3" onclick="toggleVoz()" title="Acompanhar a letra pela voz do coral" style="font-family: sans-serif;">
                <i class="bi bi-mic-fill"></i> Voz (IA)
            </button>
            <button id="btn-play" class="btn btn-success btn-sm fw-bold px-3" onclick="toggleRolagem()" style="font-family: sans-serif;">
                <i class="bi bi-play-fill"></i> Rolar
            </button>
            <label class="text-light small mb-0 d-none d-sm-inline" style="font-family: sans-serif;">Vel:</label>
            <input type="range" id="velocidade" min="1" max="10" value="3" style="width: 75px;" />
            <button class="btn btn-outline-warning btn-sm" onclick="toggleTelaCheia()" title="Tela Cheia">
                <i class="bi bi-arrows-fullscreen"></i>
            </button>
        </div>
    </div>
    <div id="cifra-container">
        @if (listaMusicas.Count > 1)
        {
            <div class="p-3 mb-5 rounded-4 border border-warning bg-black" style="font-family: sans-serif;">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h2 class="fw-bold text-warning mb-0">@nomeEvento</h2>
                    @if (!string.IsNullOrEmpty(corLiturgica))
                    {
                        <span class="badge bg-secondary">Cor: @corLiturgica</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(salmoRefrao))
                {
                    <div class="mt-2 pt-2 border-top border-secondary small text-light">
                        <strong class="text-warning">Refrão do Salmo:</strong> <span class="fst-italic">@salmoRefrao</span>
                    </div>
                }
            </div>
        }
        @for (int i = 0; i < listaMusicas.Count; i++)
        {
            var musica = listaMusicas[i];
            <div id="musica-sec-@i" class="musica-bloco">
                <div class="border-bottom border-secondary pb-3 mb-4" style="font-family: sans-serif;">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        @if (!string.IsNullOrEmpty(musica.MomentoLiturgico))
                        {
                            <span class="liturgia-badge">@musica.MomentoLiturgico</span>
                        }
                        <span class="badge bg-warning text-dark fw-bold tom-individual" data-tom-base="@(musica.TomOriginal?.ToUpper() ?? "C")">
                            Tom: @(musica.TomOriginal?.ToUpper() ?? "C")
                        </span>
                    </div>
                    <h1 class="fw-bold mb-1" style="color: #dfb235;">@musica.Titulo</h1>
                    <div class="d-flex flex-wrap align-items-center gap-3 text-light opacity-75 small">
                        <span><i class="bi bi-person-fill me-1"></i> @(string.IsNullOrEmpty(musica.Artista) ? "Ministério Shekinah" : musica.Artista)</span>
                        @if (musica.Capotraste > 0)
                        {
                            <span class="badge bg-info text-dark fw-bold">Capo original: @(musica.Capotraste)ª casa</span>
                        }
                    </div>
                </div>
                <div class="conteudo-cifra-item">@musica.Cifra</div>
            </div>
        }
    </div>
    <script>
        let lastScrollTop = 0;
        const toolbar = document.querySelector('.toolbar');
        window.addEventListener('scroll', function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            if (scrollTop > lastScrollTop && scrollTop > 60) {
                toolbar.classList.add('controls-hidden');
            } else {
                toolbar.classList.remove('controls-hidden');
            }
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, false);

        const notas = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
        const bemolParaSustenido = { "Db": "C#", "Eb": "D#", "Gb": "F#", "Ab": "G#", "Bb": "A#" };
        const ehMusicaUnica = @(listaMusicas.Count == 1 ? "true" : "false");
        const tomBaseOriginal = "@(primeiraMusica?.TomOriginal?.ToUpper() ?? "C")";
        let transposicaoTom = 0;
        let capoAtual = @(listaMusicas.Count == 1 ? (primeiraMusica?.Capotraste ?? 0) : 0);

        function irParaMusica(idSecao) {
            if (!idSecao) return;
            const el = document.getElementById(idSecao);
            if (el) el.scrollIntoView({ behavior: 'smooth' });
        }

        function normalizarTexto(str) {
            return str
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^\w\s]/g, "")
                .replace(/\s+/g, " ")
                .trim();
        }

        function quebrarLinhaComAcordes(linhaAcordes, linhaLetra, maxChars) {
            if (linhaLetra.length <= maxChars && linhaAcordes.length <= maxChars) {
                return [{ acordes: linhaAcordes, letra: linhaLetra }];
            }

            const segmentos = [];
            let pos = 0;
            const maxLen = Math.max(linhaAcordes.length, linhaLetra.length);
            const acPad = linhaAcordes.padEnd(maxLen, ' ');
            const lePad = linhaLetra.padEnd(maxLen, ' ');

            while (pos < maxLen) {
                let fim = pos + maxChars;
                if (fim < maxLen) {
                    let corte = fim;
                    while (corte > pos + 10) {
                        const charLetra = lePad[corte];
                        const charAcorde = acPad[corte];
                        const prevAcorde = acPad[corte - 1];
                        if (charLetra === ' ' && charAcorde === ' ' && prevAcorde === ' ') {
                            break;
                        }
                        corte--;
                    }
                    if (corte <= pos + 10) corte = fim;
                    fim = corte;
                } else {
                    fim = maxLen;
                }

                segmentos.push({
                    acordes: acPad.slice(pos, fim).trimEnd(),
                    letra: lePad.slice(pos, fim).trimEnd()
                });

                pos = fim;
                while (pos < maxLen && lePad[pos] === ' ' && acPad[pos] === ' ') {
                    pos++;
                }
            }
            return segmentos;
        }

        function envolverAcordesHtml(textoLinha, regexTokenAcorde) {
            return textoLinha.split(/(\s+)/).map(token => {
                let t = token.trim();
                if (t.length > 0 && t.length <= 10 && regexTokenAcorde.test(t)) {
                    return `<span class="acorde">${t}</span>`;
                }
                return token;
            }).join('');
        }

        function calcularLarguraMaximaChars() {
            const container = document.getElementById("cifra-container");
            const larguraPx = container ? container.clientWidth - 36 : window.innerWidth - 36;
            const fontSize = parseFloat(window.getComputedStyle(container).fontSize) || 18;
            const charWidth = fontSize * 0.602;
            return Math.max(24, Math.floor(larguraPx / charWidth));
        }

        function formatarAcordes() {
            const regexAcordeColchete = /\[([A-G][#b]?(?:m|maj|min|dim|aug|sus|add|\+|\-|°|0|[0-9#bM])*(?:\/[A-G][#b]?)?)\]/g;
            const regexTokenAcorde = /^[A-G][#b]?(?:m|maj|min|dim|aug|sus|add|\+|\-|°|0|[0-9#bM])*(?:\/[A-G][#b]?)?$/;
            const maxChars = calcularLarguraMaximaChars();

            document.querySelectorAll(".conteudo-cifra-item").forEach(container => {
                if (!container.hasAttribute("data-raw-cifra")) {
                    container.setAttribute("data-raw-cifra", container.textContent);
                }
                const textoOriginal = container.getAttribute("data-raw-cifra");
                const linhas = textoOriginal.split('\n');
                let htmlFinal = '';

                for (let i = 0; i < linhas.length; i++) {
                    let linha = linhas[i].replace(/\r$/, '');
                    if (linha.trim() === '') {
                        htmlFinal += '<div class="linha-vazia"></div>';
                        continue;
                    }

                    let tokens = linha.trim().split(/\s+/);
                    let ehLinhaDeAcordes = tokens.length > 0 && tokens.every(t => t.length <= 10 && regexTokenAcorde.test(t.replace(/[\[\]]/g, '')));

                    if (ehLinhaDeAcordes && i + 1 < linhas.length) {
                        let proximaLinha = linhas[i + 1].replace(/\r$/, '');
                        let tokensProx = proximaLinha.trim().split(/\s+/);
                        let proxEhAcorde = tokensProx.length > 0 && tokensProx.every(t => t.length <= 10 && regexTokenAcorde.test(t.replace(/[\[\]]/g, '')));

                        if (proximaLinha.trim() !== '' && !proxEhAcorde) {
                            let linhaAcordesLimpa = linha.replace(/\[([A-G][#b]?[^\]]*)\]/g, '$1');
                            let linhaLetraLimpa = proximaLinha.replace(/\[([A-G][#b]?[^\]]*)\]/g, '$1');
                            let fraseLimpa = normalizarTexto(linhaLetraLimpa);

                            const partes = quebrarLinhaComAcordes(linhaAcordesLimpa, linhaLetraLimpa, maxChars);
                            partes.forEach((parte, idx) => {
                                const attrFrase = (idx === 0 && fraseLimpa.length >= 4) ? ` data-frase="${fraseLimpa}"` : '';
                                const classeVoz = (fraseLimpa.length >= 4) ? ' linha-letra' : '';
                                htmlFinal += `
                                            <div class="linha-cifra-par${classeVoz}"${attrFrase}>
                                                <div class="linha-acordes">${envolverAcordesHtml(parte.acordes, regexTokenAcorde)}</div>
                                                <div class="linha-texto">${envolverAcordesHtml(parte.letra, regexTokenAcorde)}</div>
                                            </div>`;
                            });
                            i++;
                            continue;
                        }
                    }

                    let linhaSemColchetes = linha.replace(regexAcordeColchete, '');
                    let linhaLimpa = linha.replace(/\[([A-G][#b]?[^\]]*)\]/g, '$1');
                    let fraseLimpa = normalizarTexto(linhaSemColchetes);
                    let classeVoz = (!ehLinhaDeAcordes && fraseLimpa.length >= 4) ? ' linha-letra' : '';
                    let attrFrase = (!ehLinhaDeAcordes && fraseLimpa.length >= 4) ? ` data-frase="${fraseLimpa}"` : '';

                    if (ehLinhaDeAcordes) {
                        htmlFinal += `
                                    <div class="linha-cifra-par">
                                        <div class="linha-acordes">${envolverAcordesHtml(linhaLimpa, regexTokenAcorde)}</div>
                                    </div>`;
                    } else {
                        htmlFinal += `
                                    <div class="linha-cifra-par${classeVoz}"${attrFrase}>
                                        <div class="linha-texto">${envolverAcordesHtml(linhaLimpa, regexTokenAcorde)}</div>
                                    </div>`;
                    }
                }
                container.innerHTML = htmlFinal;
            });

            document.querySelectorAll(".acorde").forEach(el => {
                el.setAttribute("data-original", el.innerText);
            });
            recalcularCifra();
        }

        function transporNota(nota, semitons) {
            let base = bemolParaSustenido[nota] || nota;
            let index = notas.indexOf(base);
            if (index === -1) return nota;
            let novoIndex = (index + semitons % 12 + 12) % 12;
            return notas[novoIndex];
        }

        function recalcularCifra() {
            const deslocamentoVisual = transposicaoTom - capoAtual;
            document.querySelectorAll(".acorde").forEach(el => {
                const original = el.getAttribute("data-original");
                if (original) {
                    el.innerText = original.replace(/([A-G][#b]?)/g, (match) => {
                        return transporNota(match, deslocamentoVisual);
                    });
                }
            });
            document.querySelectorAll(".tom-individual").forEach(badge => {
                const base = badge.getAttribute("data-tom-base");
                const novoTom = base.replace(/([A-G][#b]?)/g, (match) => transporNota(match, transposicaoTom));
                badge.innerText = "Tom: " + novoTom;
            });
            const tomDisplay = document.getElementById("tom-display");
            if (tomDisplay) {
                if (ehMusicaUnica) {
                    tomDisplay.innerText = tomBaseOriginal.replace(/([A-G][#b]?)/g, (match) => transporNota(match, transposicaoTom));
                } else {
                    tomDisplay.innerText = transposicaoTom === 0 ? "Original" : (transposicaoTom > 0 ? `+${transposicaoTom} st` : `${transposicaoTom} st`);
                }
            }
        }

        function alterarTom(semitons) {
            transposicaoTom += semitons;
            recalcularCifra();
        }

        function alterarCapo() {
            capoAtual = parseInt(document.getElementById("capo-select").value) || 0;
            recalcularCifra();
        }

        let tamanhoAtual = window.innerWidth <= 576 ? 16 : 18;
        function mudarFonte(delta) {
            tamanhoAtual = Math.max(12, Math.min(36, tamanhoAtual + delta));
            document.getElementById("cifra-container").style.fontSize = tamanhoAtual + "px";
            formatarAcordes();
        }

        let rolando = false;
        let intervaloRolagem = null;
        function toggleRolagem() {
            const btn = document.getElementById("btn-play");
            if (rolando) {
                clearInterval(intervaloRolagem);
                rolando = false;
                btn.innerHTML = '<i class="bi bi-play-fill"></i> Rolar';
                btn.classList.replace("btn-danger", "btn-success");
            } else {
                if (vozAtiva) toggleVoz();
                rolando = true;
                btn.innerHTML = '<i class="bi bi-pause-fill"></i> Pausar';
                btn.classList.replace("btn-success", "btn-danger");
                intervaloRolagem = setInterval(() => {
                    const vel = parseInt(document.getElementById("velocidade").value);
                    window.scrollBy(0, vel * 0.45);
                }, 30);
            }
        }

        let recognition = null;
        let vozAtiva = false;
        let pulsoMicInterval = null;
        function toggleVoz() {
            const btnVoz = document.getElementById("btn-voz");
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Seu navegador não suporta reconhecimento de voz. Use o Google Chrome ou Edge.");
                return;
            }
            if (!vozAtiva) {
                if (rolando) toggleRolagem();
                recognition = new SpeechRecognition();
                recognition.lang = 'pt-BR';
                recognition.continuous = true;
                recognition.interimResults = true;
                recognition.onstart = function() {
                    vozAtiva = true;
                    btnVoz.classList.remove("btn-outline-warning");
                    btnVoz.classList.add("btn-warning", "text-dark");
                    btnVoz.innerHTML = '<i class="bi bi-mic-fill"></i> Ouvindo...';
                    let brilho = false;
                    pulsoMicInterval = setInterval(() => {
                        brilho = !brilho;
                        btnVoz.style.boxShadow = brilho ? "0 0 12px rgba(223, 178, 53, 0.9)" : "none";
                    }, 600);
                };
                recognition.onresult = function(event) {
                    let textoCapturado = '';
                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        textoCapturado += event.results[i][0].transcript + " ";
                    }
                    sincronizarLetraPorVoz(normalizarTexto(textoCapturado));
                };
                recognition.onerror = function(event) {
                    console.warn("Aviso no microfone:", event.error);
                };
                recognition.onend = function() {
                    if (vozAtiva) {
                        try { recognition.start(); } catch (e) { }
                    }
                };
                recognition.start();
            } else {
                vozAtiva = false;
                clearInterval(pulsoMicInterval);
                btnVoz.style.boxShadow = "none";
                if (recognition) {
                    recognition.stop();
                }
                btnVoz.classList.remove("btn-warning", "text-dark");
                btnVoz.classList.add("btn-outline-warning");
                btnVoz.innerHTML = '<i class="bi bi-mic-fill"></i> Voz (IA)';
                
                document.querySelectorAll(".linha-ativa-voz").forEach(el => {
                    el.classList.remove("linha-ativa-voz");
                });
            }
        }

        function sincronizarLetraPorVoz(falaNormalizada) {
            if (!falaNormalizada || falaNormalizada.length < 4) return;
            const linhas = document.querySelectorAll(".linha-letra");
            let melhorLinha = null;
            let maiorPontuacao = 0;
            const palavrasFaladas = falaNormalizada.split(" ").filter(p => p.length > 2);
            if (palavrasFaladas.length === 0) return;
            linhas.forEach(linha => {
                const fraseLinha = linha.getAttribute("data-frase");
                if (!fraseLinha) return;
                if (falaNormalizada.includes(fraseLinha) || (fraseLinha.length > 8 && fraseLinha.includes(falaNormalizada))) {
                    melhorLinha = linha;
                    maiorPontuacao = 100;
                    return;
                }
                if (maiorPontuacao < 100) {
                    let acertos = 0;
                    palavrasFaladas.forEach(palavra => {
                        if (fraseLinha.includes(palavra)) acertos++;
                    });
                    let percentual = acertos / palavrasFaladas.length;
                    if (acertos >= 2 && percentual >= 0.6 && percentual > maiorPontuacao) {
                        maiorPontuacao = percentual;
                        melhorLinha = linha;
                    }
                }
            });
            if (melhorLinha) {
                document.querySelectorAll(".linha-ativa-voz").forEach(el => {
                    el.classList.remove("linha-ativa-voz");
                });
                melhorLinha.classList.add("linha-ativa-voz");
                melhorLinha.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        function toggleTelaCheia() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
            } else if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }

        let resizeTimer;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => {
                formatarAcordes();
            }, 200);
        });

        document.addEventListener("DOMContentLoaded", () => {
            formatarAcordes();
        });
    </script>
</body>
</html>