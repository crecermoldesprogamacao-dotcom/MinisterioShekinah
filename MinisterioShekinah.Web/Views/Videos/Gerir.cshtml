@model IEnumerable<MinisterioShekinah.Web.Models.VideoItem>

@{
    ViewData["Title"] = "Gestão de Vídeos - Ministério Shekinah";
}

<div class="container my-5" style="max-width: 1000px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 mb-1">ÁREA RESTRITA</span>
            <h2 class="text-warning fw-bold mb-0">Gestão de Vídeos & Louvores</h2>
        </div>
        <div>
            <a href="/Videos/Adicionar" class="btn btn-warning text-dark fw-bold rounded-pill px-3 me-2">
                <i class="bi bi-plus-circle-fill me-1"></i> Adicionar Vídeo
            </a>
            <a href="/Videos/Index" class="btn btn-outline-light rounded-pill px-3">
                <i class="bi bi-eye-fill me-1"></i> Ver Galeria
            </a>
        </div>
    </div>

    <div class="card bg-dark border-warning shadow-lg rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-warning border-bottom border-warning">
                        <th>Data</th>
                        <th>Título</th>
                        <th>Descrição</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var video in Model)
                        {
                            <tr>
                                <td class="text-nowrap small text-warning">@video.DataPublicacao.ToString("dd/MM/yyyy")</td>
                                <td class="fw-bold">@video.Titulo</td>
                                <td class="text-muted small">@video.Descricao</td>
                                <td class="text-end">
                                    <form asp-action="Eliminar" asp-route-id="@video.Id" method="post" class="d-inline" onsubmit="return confirm('Tem a certeza que deseja eliminar este vídeo?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Nenhum vídeo registado até ao momento.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>