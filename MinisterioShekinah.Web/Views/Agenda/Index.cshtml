@model IEnumerable<MinisterioShekinah.Web.Models.AgendaItem>
@{
    ViewData["Title"] = "Agenda & Escalas - Ministério Shekinah";
}

<div class="container my-5" style="max-width: 1000px;">
    <!-- Cabeçalho da Página -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-2">AGENDA LITÚRGICA</span>
        <h1 class="text-warning fw-bold display-5">Próximos Compromissos & Ensaios</h1>
        <p class="text-light opacity-75">Acompanhe as nossas escalas para a Santa Missa, ensaios semanais e momentos de adoração em Valinhos/SP.</p>

        <!-- Botão de Acesso Administrativo / Adicionar Eventos -->
        @if (Context.Session.GetString("AdminLogado") == "True")
        {
            <div class="mt-4">
                <a href="/Admin/CriarEvento" class="btn btn-warning text-dark fw-bold px-4 py-2 rounded-pill shadow-sm me-2">
                    <i class="bi bi-plus-circle-fill me-2"></i> Novo Evento
                </a>
                <a href="/Admin/Painel" class="btn btn-outline-warning text-warning fw-bold px-4 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-gear-fill me-2"></i> Gerir Painel
                </a>
            </div>
        }
        else
        {
            <div class="mt-3">
                <a href="/Admin/Login" class="text-warning small text-decoration-none opacity-75">
                    <i class="bi bi-lock-fill me-1"></i> Acesso Administrativo
                </a>
            </div>
        }
    </div>

    <!-- Lista de Eventos -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var evento in Model)
            {
                <div class="col-md-6">
                    <div class="card bg-dark border-warning shadow-lg rounded-4 h-100 p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-warning text-dark fw-bold px-3 py-1">@evento.Tipo</span>
                                    <span class="text-warning fw-semibold small"><i class="bi bi-calendar-event me-1"></i> @evento.DataHora.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <h3 class="text-white fw-bold mb-2">@evento.Titulo</h3>
                                <p class="text-light opacity-75 small mb-3">
                                    <i class="bi bi-geo-alt-fill text-warning me-1"></i> @evento.Local
                                </p>
                                <p class="text-light small">@evento.Descricao</p>
                            </div>
                            <div class="pt-3 border-top border-secondary mt-3">
                                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i> Ministério Shekinah - Valinhos/SP</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Estado Vazio / Exemplo Visual Elegante -->
        <div class="card bg-dark border-secondary shadow-lg rounded-4 p-5 text-center">
            <div class="card-body">
                <i class="bi bi-calendar-x display-3 text-warning mb-3"></i>
                <h3 class="text-white fw-bold">Nenhum evento agendado de momento</h3>
                <p class="text-light opacity-75 mb-4">Em breve publicaremos as escalas das próximas Santas Missas e ensaios do ministério.</p>
                
                @if (Context.Session.GetString("AdminLogado") == "True")
                {
                    <div class="mb-4">
                        <a href="/Admin/CriarEvento" class="btn btn-warning text-dark fw-bold px-4 rounded-pill shadow-sm">
                            <i class="bi bi-plus-circle-fill me-2"></i> Adicionar Primeiro Evento
                        </a>
                    </div>
                }

                <div class="p-3 bg-black border border-warning rounded-3 d-inline-block text-start">
                    <h5 class="text-warning fw-bold mb-1"><i class="bi bi-music-note-beamed me-2"></i> Exemplo de Compromisso Habitual:</h5>
                    <ul class="text-light small mb-0 ps-3">
                        <li><strong>Ensaios Gerais:</strong> Quintas-feiras às 20h00</li>
                        <li><strong>Santa Missa Dominical:</strong> Domingos às 19h00</li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>

<style>
    body {
        background-color: #121212;
        color: #f8f9fa;
    }

    .text-warning {
        color: #dfb235 !important;
    }

    .border-warning {
        border-color: #dfb235 !important;
    }

    .bg-warning {
        background-color: #dfb235 !important;
    }
</style>