@model IEnumerable<MinisterioShekinah.Web.Models.MembroEquipe>

@{
    ViewData["Title"] = "Gestão da Página Sobre - Ministério Shekinah";
    var sobre = ViewBag.Sobre as MinisterioShekinah.Web.Models.SobreMinisterio;
}

<div class="container my-5" style="max-width: 1000px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 mb-1">ÁREA RESTRITA</span>
            <h2 class="text-warning fw-bold mb-0">Gestão da Página "Sobre Nós"</h2>
        </div>
        <div>
            <a href="/Sobre/EditarTexto" class="btn btn-outline-warning text-warning fw-bold rounded-pill px-3 me-2">
                <i class="bi bi-pencil-square me-1"></i> Editar História & Missão
            </a>
            <a href="/Sobre/Index" class="btn btn-outline-light rounded-pill px-3">
                <i class="bi bi-eye-fill me-1"></i> Ver Página
            </a>
        </div>
    </div>

    <!-- Pré-visualização dos Textos Atuais -->
    <div class="card bg-dark border-warning shadow-lg rounded-4 p-4 mb-4">
        <h4 class="text-warning fw-bold mb-3"><i class="bi bi-info-circle-fill me-2"></i> Textos Institucionais Atuais</h4>
        <div class="row">
            <div class="col-md-6 mb-3">
                <h6 class="text-white fw-bold">@sobre?.TituloHistoria</h6>
                <p class="text-light small opacity-75">@(sobre?.TextoHistoria.Length > 120 ? sobre.TextoHistoria.Substring(0, 120) + "..." : sobre?.TextoHistoria)</p>
            </div>
            <div class="col-md-6 mb-3">
                <h6 class="text-white fw-bold">@sobre?.TituloMissao</h6>
                <p class="text-light small opacity-75">@(sobre?.TextoMissao.Length > 120 ? sobre.TextoMissao.Substring(0, 120) + "..." : sobre?.TextoMissao)</p>
            </div>
        </div>
    </div>

    <!-- Gestão de Membros -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-warning fw-bold m-0">Membros da Equipa</h3>
        <a href="/Sobre/AdicionarMembro" class="btn btn-warning text-dark fw-bold rounded-pill px-3">
            <i class="bi bi-plus-circle-fill me-1"></i> Adicionar Membro
        </a>
    </div>

    <div class="card bg-dark border-warning shadow-lg rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-warning border-bottom border-warning">
                        <th>Nome</th>
                        <th>Função</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var membro in Model)
                        {
                            <tr>
                                <td class="fw-bold">@membro.Nome</td>
                                <td><span class="badge bg-secondary text-warning">@membro.Funcao</span></td>
                                <td class="text-end">
                                    <form asp-action="EliminarMembro" asp-route-id="@membro.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja eliminar este membro?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Nenhum membro registado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>