@model MinisterioShekinah.Web.Models.MembroEquipe

@{
    ViewData["Title"] = "Adicionar Membro - Ministério Shekinah";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card bg-dark border-warning shadow-lg rounded-4 p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="badge bg-warning text-dark fw-bold px-3 py-1 mb-1">NOVO MEMBRO</span>
                <h2 class="text-warning fw-bold mb-0">Adicionar à Equipa</h2>
            </div>
            <a href="/Sobre/Gerir" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>

        <form asp-action="AdicionarMembro" method="post">
            <div class="mb-3">
                <label asp-for="Nome" class="form-label text-light small fw-semibold">Nome Completo</label>
                <input asp-for="Nome" class="form-control bg-black text-light border-secondary" placeholder="Ex: Mariana Silva" required />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Funcao" class="form-label text-light small fw-semibold">Função / Instrumento</label>
                <input asp-for="Funcao" class="form-control bg-black text-light border-secondary" placeholder="Ex: Vocalista / Teclado" required />
                <span asp-validation-for="Funcao" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FotoUrl" class="form-label text-light small fw-semibold">URL da Foto (Opcional)</label>
                <input asp-for="FotoUrl" class="form-control bg-black text-light border-secondary" placeholder="https://exemplo.com/foto.jpg" />
                <span asp-validation-for="FotoUrl" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Bio" class="form-label text-light small fw-semibold">Breve Biografia / Trajetória</label>
                <textarea asp-for="Bio" class="form-control bg-black text-light border-secondary" rows="3" placeholder="Servindo no ministério desde..."></textarea>
                <span asp-validation-for="Bio" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 rounded-pill shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i> Guardar Membro
            </button>
        </form>
    </div>
</div>