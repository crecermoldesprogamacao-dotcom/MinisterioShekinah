@model MinisterioShekinah.Web.Models.SobreMinisterio

@{
    ViewData["Title"] = "Editar História e Missão - Ministério Shekinah";
}

<div class="container my-5" style="max-width: 700px;">
    <div class="card bg-dark border-warning shadow-lg rounded-4 p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="badge bg-warning text-dark fw-bold px-3 py-1 mb-1">GESTÃO INSTITUCIONAL</span>
                <h2 class="text-warning fw-bold mb-0">Editar História & Missão</h2>
            </div>
            <a href="/Sobre/Gerir" class="btn btn-outline-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar
            </a>
        </div>

        <form asp-action="EditarTexto" method="post">
            <input type="hidden" asp-for="Id" />

            <h4 class="text-white border-bottom border-secondary pb-2 mb-3">Bloco da História</h4>
            
            <div class="mb-3">
                <label asp-for="TituloHistoria" class="form-label text-light small fw-semibold">Título</label>
                <input asp-for="TituloHistoria" class="form-control bg-black text-light border-secondary" required />
                <span asp-validation-for="TituloHistoria" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="TextoHistoria" class="form-label text-light small fw-semibold">Texto / Descrição da História</label>
                <textarea asp-for="TextoHistoria" class="form-control bg-black text-light border-secondary" rows="5" required></textarea>
                <span asp-validation-for="TextoHistoria" class="text-danger small"></span>
            </div>

            <h4 class="text-white border-bottom border-secondary pb-2 mb-3">Bloco de Missão & Valores</h4>

            <div class="mb-3">
                <label asp-for="TituloMissao" class="form-label text-light small fw-semibold">Título</label>
                <input asp-for="TituloMissao" class="form-control bg-black text-light border-secondary" required />
                <span asp-validation-for="TituloMissao" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="TextoMissao" class="form-label text-light small fw-semibold">Texto / Descrição da Missão</label>
                <textarea asp-for="TextoMissao" class="form-control bg-black text-light border-secondary" rows="5" required></textarea>
                <span asp-validation-for="TextoMissao" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 rounded-pill shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i> Guardar Alterações
            </button>
        </form>
    </div>
</div>